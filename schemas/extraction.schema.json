{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.example/schemas/extraction.schema.json",
  "title": "GovFlow Staged Extraction Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "claims", "provider", "model", "prompt_version", "pipeline_version"],
  "properties": {
    "task": { "enum": ["fields", "actors", "requirements", "workflow", "decisions", "deadlines", "inspections", "fees", "missing_references", "ambiguities"] },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "value", "origin", "confidence", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "value": { "type": "object" },
          "origin": { "enum": ["explicit", "inferred", "unknown", "conflicted"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "govflow-workflow.schema.json#/$defs/evidence" } },
          "qualifiers": {
            "type": "object",
            "properties": {
              "modality": { "enum": ["must", "shall", "may", "should", "typically", "unknown"] },
              "decision_maker": { "type": ["string", "null"] },
              "trigger": { "type": ["object", "null"] },
              "exception": { "type": ["string", "null"] },
              "temporal_qualifier": { "type": ["string", "null"] },
              "human_discretion": { "type": "boolean" }
            }
          }
        }
      }
    },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "prompt_version": { "type": "string" },
    "pipeline_version": { "type": "string" }
  }
}
