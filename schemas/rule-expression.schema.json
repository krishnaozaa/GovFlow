{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.example/schemas/rule-expression.schema.json",
  "title": "GovFlow Safe Rule Expression",
  "$ref": "#/$defs/expression",
  "$defs": {
    "value": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": {} } },
        { "type": "object", "additionalProperties": false, "required": ["literal_minor_units"], "properties": { "literal_minor_units": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["ref"], "properties": { "ref": { "type": "string", "pattern": "^(fields|project|document|calculated)\\.[a-zA-Z0-9_]+$" } } }
      ]
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/value" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": { "enum": ["all", "any", "not", "add", "subtract", "multiply", "divide", "min", "max"] },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left"],
          "properties": {
            "op": { "enum": ["equal", "not_equal", "greater_than", "greater_than_or_equal", "less_than", "less_than_or_equal", "in", "not_in", "exists", "is_empty", "contains", "starts_with", "ends_with", "matches"] },
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "condition", "then", "else"],
          "properties": {
            "op": { "const": "if" },
            "condition": { "$ref": "#/$defs/expression" },
            "then": { "$ref": "#/$defs/expression" },
            "else": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    }
  }
}
